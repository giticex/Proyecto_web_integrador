    {
      "name": "5. Ventas",
      "item": [
        {
          "name": "Registrar BOLETA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ventas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ventas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCliente\": \"CLI001\",\n  \"tipoDocumento\": \"TD001\",\n  \"medioPago\": \"MP001\",\n  \"numeroDocumento\": \"12345678\",\n  \"items\": [\n    {\n      \"idProducto\": 2,\n      \"cantidad\": 2\n    },\n    {\n      \"idProducto\": 6,\n      \"cantidad\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Guarda idVenta en una variable para las siguientes peticiones."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const v = pm.response.json();",
                  "pm.collectionVariables.set('idVenta', v.idVenta);",
                  "pm.test('Número de boleta B001-xxxxxxxx', function () { pm.expect(v.numeroDocumento).to.match(/^B001-\\d{8}$/); });",
                  "pm.test('Tipo Boleta', function () { pm.expect(v.tipoDocumento).to.eql('Boleta'); });",
                  "pm.test('Total = 2x45 + 1x25 = 115', function () { pm.expect(Number(v.total)).to.eql(115); });",
                  "pm.test('opGravada + igv = total', function () { pm.expect(Number((Number(v.opGravada) + Number(v.igv)).toFixed(2))).to.eql(Number(v.total)); });",
