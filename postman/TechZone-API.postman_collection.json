{
  "info": {
    "name": "TechZone API",
    "description": "Colección de pruebas del backend TechZone (Spring Boot).\n\nOrden recomendado: ejecutar las carpetas 1 a 7 en orden con el Collection Runner (la carpeta 1 deja la sesión como ADMIN y Postman guarda la cookie JSESSIONID).\nRequisitos: MySQL con database/script_mysql.sql cargado y backend en http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Login cliente (CLI001)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
